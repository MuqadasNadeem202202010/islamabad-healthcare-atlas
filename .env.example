# Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_atlas
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# Required to add or update records from the website form
ADMIN_KEY=choose_a_secret_key

PORT=3000

# On Vercel (cloud database) use this instead of the DB_* values:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DB_SSL=true